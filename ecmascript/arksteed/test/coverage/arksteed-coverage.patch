diff --git a/ecmascript/compiler/BUILD.gn b/ecmascript/compiler/BUILD.gn
index 1494135..3a531bb 100644
--- a/ecmascript/compiler/BUILD.gn
+++ b/ecmascript/compiler/BUILD.gn
@@ -41,6 +41,25 @@ config("include_maple") {
   cflags_cc = [ "-Wno-gnu-zero-variadic-macro-arguments" ]
 }
 
+# Numeric C++ coverage measurement of the ArkSteed JIT compiler. Both configs
+# are inert unless `arksteed_coverage` (js_runtime_config.gni) is true. The
+# compile config instruments the translation units of
+# `libark_jsoptimizer_set_with_maple`, which is where the ArkSteed compiler
+# sources (`arksteed_jit_sources`) are compiled, and of `libark_jsruntime_set`
+# (js_runtime_config.gni), which is where the ArkSteed runtime sources
+# (`arksteed_deopt_helper.cpp`, `arksteed_safepoint_table.cpp`,
+# `arksteed_task.cpp`) are compiled; together these cover every production
+# translation unit of `ecmascript/arksteed`. The link config is published as a
+# public config so every target that links those objects also links the
+# coverage runtime and flushes the profile on exit.
+config("arksteed_coverage_compile") {
+  cflags_cc = [ "--coverage" ]
+}
+
+config("arksteed_coverage_link") {
+  ldflags = [ "--coverage" ]
+}
+
 libark_jsoptimizer_sources = [
   "access_object_stub_builder.cpp",
   "aot_compilation_env.cpp",
@@ -355,6 +374,15 @@ ohos_source_set("libark_jsoptimizer_set_with_maple") {
     ":enable_maple_config",
   ]
 
+  if (arksteed_coverage) {
+    # Coverage measurement build (off by default): instrument every translation
+    # unit of this source set, including the ArkSteed production files
+    # (`arksteed_jit_sources`), and publish the link flag to the targets that
+    # link them.
+    configs = [ ":arksteed_coverage_compile" ]
+    public_configs += [ ":arksteed_coverage_link" ]
+  }
+
   defines = []
 
   if (ets_runtime_enable_ark_steed) {
diff --git a/js_runtime_config.gni b/js_runtime_config.gni
index f065b14..6ad22f4 100644
--- a/js_runtime_config.gni
+++ b/js_runtime_config.gni
@@ -60,6 +60,17 @@ declare_args() {
   # Enable ark_steed (ArkSteed JIT compiler)
   ets_runtime_enable_ark_steed = false && !is_arkui_x
 
+  # Compile the translation units that carry the ArkSteed JIT compiler with
+  # clang coverage instrumentation (`--coverage`) and link the coverage runtime
+  # into the targets that consume them. Disabled by default, so a normal build
+  # compiles and links exactly as before; this is the measurement build used by
+  # the numeric C++ coverage of the ArkSteed JIT compiler
+  # (`ecmascript/arksteed/test/coverage/`, ISSUE-0059 and ISSUE-0011). It is a
+  # separate argument because `enable_coverage` below is a plain variable that
+  # several build files assign unconditionally and never declare through
+  # `declare_args()`, so `--gn-args=enable_coverage=true` has no effect and no
+  # coverage flag reaches the ArkSteed sources.
+  arksteed_coverage = false
 
   # Defaults for fort
   ets_runtime_support_jit_code_sign = false
@@ -329,6 +340,18 @@ template("libark_jsruntime_common_set") {
       configs += [ "$js_root:dfx_extra_config" ]
     }
 
+    if (arksteed_coverage) {
+      # Coverage measurement build (off by default). The ArkSteed runtime
+      # sources (arksteed_deopt_helper.cpp, arksteed_safepoint_table.cpp,
+      # arksteed_task.cpp) are compiled into this source set, so the compile
+      # config instruments every translation unit of the set and the published
+      # link config passes the coverage runtime to the targets that link those
+      # objects (`libark_jsruntime`) and flushes the profile on exit.
+      configs += [ "$js_root/ecmascript/compiler:arksteed_coverage_compile" ]
+      public_configs +=
+          [ "$js_root/ecmascript/compiler:arksteed_coverage_link" ]
+    }
+
     cflags_cc = []
     if (is_standard_system || target_os == "android" || target_os == "ios") {
       cflags_cc += [ "-fvisibility=hidden" ]
@@ -625,6 +648,15 @@ template("libark_jsruntime_shared_library_template") {
       ":ark_jsruntime_common_config",
       ":arkjs_runtime_lto_link_config",
     ]
+    if (arksteed_coverage) {
+      # Link the coverage runtime into the shared library that links the
